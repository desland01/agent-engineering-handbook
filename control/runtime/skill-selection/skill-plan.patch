+// The terminal skill-plan verdict. Invocation is only knowable after the run, so this is
+// measured once at termination and never per request: a request forwarded before the second
+// skill of a chain is invoked is legitimate. Invocation is the whole claim — a planned Chart
+// counts on one successful native Skill result, a failed invocation does not count, and a
+// required Chart outside the plan is unaffected. Whether the method shaped the work is not
+// measured here and is not asserted by this verdict.
+export function skillPlanVerdict(skillPlan, summary) {
+  const planned = (skillPlan ?? []).map(entry => entry.chart);
+  const missing = new Set(summary?.withoutSuccessfulInvocation ?? []);
+  const uninvoked = planned.filter(chart => missing.has(chart));
+  return {allInvoked: uninvoked.length === 0, uninvoked, planned, reason: uninvoked.length === 0 ? null : 'capsule_skill_plan_uninvoked'};
