+// The release ceiling for run egress and external reads. It is the only thing that can put
+// a destination or an outside path inside a run, so a malformed ceiling refuses the release
+// rather than resolving to "grant nothing" or, worse, "grant everything".
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {validateAnchor} from '../src/release.js';
+
+const anchor = JSON.parse(readFileSync('release/anchor.json', 'utf8'));
+const sandbox = {
+  version: 1,
+  readableRoots: ['/Users/thebeast/ranger-painting-full-build'],
+  network: {allowedDomains: ['www.rangerpainting.com', '*.staging.rangerpainting.com'], allowLocalBinding: false},
+};
+
+test('a well-shaped ceiling is carried through', () => {
+  const validated = validateAnchor({...anchor, sandbox});
+  assert.deepEqual(validated.sandbox, sandbox);
+  // An empty ceiling is meaningful: it grants nothing, explicitly.
+  assert.deepEqual(validateAnchor({...anchor, sandbox: {version: 1, readableRoots: [], network: {allowedDomains: [], allowLocalBinding: false}}}).sandbox!.network.allowedDomains, []);
+});
+
+test('a release with no ceiling keeps its previous shape', () => {
+  assert.equal(validateAnchor(anchor).sandbox, undefined);
+});
+
+test('a malformed ceiling refuses the release', () => {
+  const bad = [
+    null, true, {},
+    {...sandbox, version: 2},
+    {...sandbox, extra: true},
+    {version: 1, readableRoots: [], network: {allowedDomains: [], allowLocalBinding: false}, unknown: 1},
+    {...sandbox, readableRoots: ['relative/path']},
+    {...sandbox, readableRoots: ['/Users/x/..']},
+    {...sandbox, readableRoots: ['/Users/**']},
+    {...sandbox, readableRoots: '/Users/x'},
+    {...sandbox, network: {allowedDomains: ['www.rangerpainting.com']}},
+    {...sandbox, network: {allowedDomains: 'www.rangerpainting.com', allowLocalBinding: false}},
+    {...sandbox, network: {allowedDomains: [42], allowLocalBinding: false}},
+    {...sandbox, network: {allowedDomains: ['https://www.rangerpainting.com'], allowLocalBinding: false}},
+    {...sandbox, network: {allowedDomains: ['www.rangerpainting.com'], allowLocalBinding: 'yes'}},
+  ];
+  for (const candidate of bad) assert.throws(() => validateAnchor({...anchor, sandbox: candidate}), /invalid_sandbox/, JSON.stringify(candidate));
+});
+
+test('the ceiling cannot open the whole internet in one entry', () => {
+  // A release may grant a site. Granting every host under a public suffix, or every host at
+  // all, is not a ceiling, and the owner has to name what the business actually reaches.
+  for (const domain of ['*', '*.com', '*.co.uk', '*.io']) {
+    assert.throws(() => validateAnchor({...anchor, sandbox: {...sandbox, network: {allowedDomains: [domain], allowLocalBinding: false}}}), /invalid_sandbox/, domain);
+  }
+  assert.doesNotThrow(() => validateAnchor({...anchor, sandbox: {...sandbox, network: {allowedDomains: ['*.rangerpainting.com'], allowLocalBinding: false}}}));
+});
