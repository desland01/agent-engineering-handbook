+// The run's egress path: which destinations a granted capsule may reach, and the refusal
+// shape for everything else. Node builtins only.
+import {test, describe} from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import net from 'node:net';
+import {once} from 'node:events';
+
+import {egressTarget, attachEgress} from '../../src/egress.mjs';
+
+const POLICY = {allowedDomains: ['www.rangerpainting.com', '*.staging.rangerpainting.com'], allowLocalBinding: false};
+const LOCAL = {allowedDomains: ['localhost', '127.0.0.1'], allowLocalBinding: true};
+
+describe('what a granted run may reach', () => {
+  test('an admitted host on a web port is a target', () => {
+    assert.deepEqual(egressTarget('www.rangerpainting.com:443', POLICY), {ok: true, host: 'www.rangerpainting.com', port: 443});
+    assert.deepEqual(egressTarget('www.rangerpainting.com:80', POLICY), {ok: true, host: 'www.rangerpainting.com', port: 80});
+  });
+
+  test('a wildcard grant admits a subdomain and nothing above it', () => {
+    assert.equal(egressTarget('preview.staging.rangerpainting.com:443', POLICY).ok, true);
+    assert.equal(egressTarget('staging.rangerpainting.com:443', POLICY).ok, false);
+  });
+
+  test('a host the capsule never named is refused', () => {
+    const verdict = egressTarget('exfiltrate.example.com:443', POLICY);
+    assert.equal(verdict.ok, false);
+    assert.equal(verdict.reason, 'egress_host_not_admitted');
+  });
+
+  test('a port that is not the web is refused even on an admitted host', () => {
+    for (const url of ['www.rangerpainting.com:22', 'www.rangerpainting.com:5432', 'www.rangerpainting.com:0']) {
+      assert.equal(egressTarget(url, POLICY).reason, 'egress_port_not_admitted', url);
+    }
+  });
+
+  test('a granted local service is reachable on the port it listens on, and only then', () => {
+    assert.deepEqual(egressTarget('localhost:3000', LOCAL), {ok: true, host: 'localhost', port: 3000});
+    assert.equal(egressTarget('localhost:3000', {allowedDomains: ['localhost'], allowLocalBinding: false}).reason, 'egress_local_address_not_admitted');
+    assert.equal(egressTarget('localhost:70000', LOCAL).reason, 'egress_port_not_admitted');
+  });
+
+  test('a malformed target is refused rather than guessed', () => {
+    for (const url of ['', 'www.rangerpainting.com', 'http://www.rangerpainting.com:443', ':443', undefined]) {
+      assert.equal(egressTarget(url, POLICY).ok, false, String(url));
+    }
+  });
+
+  test('a loopback or private literal needs the local-binding grant', () => {
+    for (const host of ['127.0.0.1', '10.0.0.5', '192.168.1.9', '172.16.4.4', '169.254.169.254', '[::1]']) {
+      const open = egressTarget(host + ':443', {allowedDomains: [host.replace(/[[\]]/g, '')], allowLocalBinding: false});
+      assert.equal(open.ok, false, host + ' must not be reachable without the grant');
+      assert.equal(open.reason, 'egress_local_address_not_admitted');
+    }
+    assert.equal(egressTarget('127.0.0.1:443', LOCAL).ok, true);
+  });
+});
+
+describe('the tunnel itself', () => {
+  test('an admitted CONNECT reaches the origin and a refused one is closed', async (t) => {
+    const origin = net.createServer((socket) => {
+      socket.on('data', (chunk) => socket.write('origin saw: ' + chunk.toString()));
+    });
+    origin.listen(0, '127.0.0.1');
+    await once(origin, 'listening');
+    const originPort = origin.address().port;
+
+    const events = [];
+    const proxy = http.createServer();
+    attachEgress(proxy, {
+      allowedDomains: ['127.0.0.1'],
+      allowLocalBinding: true,
+      observe: (event) => events.push(event),
+    });
+    proxy.listen(0, '127.0.0.1');
+    await once(proxy, 'listening');
+    const proxyPort = proxy.address().port;
+    t.after(() => {proxy.close(); origin.close();});
+
+    const connect = (target) => new Promise((resolve) => {
+      const socket = net.connect(proxyPort, '127.0.0.1', () => {
+        socket.write('CONNECT ' + target + ' HTTP/1.1\r\nHost: ' + target + '\r\n\r\n');
+      });
+      let buffer = '';
+      socket.on('data', (chunk) => {
+        buffer += chunk.toString();
+        if (buffer.includes('200 Connection Established') && !buffer.includes('origin saw')) socket.write('hello');
+        if (buffer.includes('origin saw')) {socket.end(); resolve(buffer);}
+      });
+      socket.on('close', () => resolve(buffer));
+      socket.on('error', () => resolve(buffer));
+    });
+
+    const allowed = await connect('127.0.0.1:' + originPort);
+    assert.match(allowed, /200 Connection Established/);
+    assert.match(allowed, /origin saw: hello/);
+
+    const refused = await connect('exfiltrate.example.com:443');
+    assert.match(refused, /403 Forbidden/);
+    assert.doesNotMatch(refused, /200 Connection Established/);
+
+    // Every attempt is on the record, allowed or not: an egress that leaves no trace is
+    // not an auditable one. The tunnel's own record is written when it closes, so the two
+    // records are asserted as a set, not in arrival order.
+    const deadline = Date.now() + 2000;
+    while (events.length < 2 && Date.now() < deadline) await new Promise((r) => setTimeout(r, 10));
+    assert.equal(events.length, 2, JSON.stringify(events));
+    assert.ok(events.every((e) => e.kind === 'egress_request'));
+    const tunnelled = events.find((e) => e.allowed === true);
+    const blocked = events.find((e) => e.allowed === false);
+    assert.ok(tunnelled, 'the admitted tunnel is recorded');
+    assert.ok(tunnelled.bytes > 0, 'the record carries the transferred byte count');
+    assert.equal(blocked.reason, 'egress_host_not_admitted');
+    assert.equal(blocked.host, 'exfiltrate.example.com');
+  });
+
+  test('a server with no admitted host keeps the unconditional refusal', async (t) => {
+    const proxy = http.createServer();
+    attachEgress(proxy, {allowedDomains: [], allowLocalBinding: false, observe: () => {}});
+    proxy.listen(0, '127.0.0.1');
+    await once(proxy, 'listening');
+    t.after(() => proxy.close());
+    const port = proxy.address().port;
+    const answer = await new Promise((resolve) => {
+      const socket = net.connect(port, '127.0.0.1', () => socket.write('CONNECT www.rangerpainting.com:443 HTTP/1.1\r\n\r\n'));
+      let buffer = '';
+      socket.on('data', (chunk) => {buffer += chunk.toString();});
+      socket.on('close', () => resolve(buffer));
+      socket.on('error', () => resolve(buffer));
+    });
+    assert.match(answer, /403 Forbidden/);
+  });
+});
