+// Run egress: the CONNECT path for a capsule that was granted named hosts.
+//
+// This module never decides what a run may reach. `capsuleSandboxScopes` already narrowed
+// the capsule's declaration against the release ceiling; the admitted list arrives here as
+// data. The only judgements made here are mechanical: is this target one of the admitted
+// hosts, on a web port, and not a local address the run was not granted. Everything else
+// is closed with the same 403 the model endpoint has always answered CONNECT with.
+//
+// Dependency-free: node builtins only.
+import net from 'node:net';
+import {domainCovered} from './capsule-admission.mjs';
+
+const WEB_PORTS = [80, 443];
+// Loopback, link-local and the RFC1918 ranges. A granted public hostname that resolves
+// into one of these is a rebinding attempt, not a destination the ceiling approved.
+const LOCAL_V4 = [/^127\./, /^10\./, /^192\.168\./, /^172\.(1[6-9]|2[0-9]|3[01])\./, /^169\.254\./, /^0\.0\.0\.0$/];
+
+export function isLocalAddress(host) {
+  const bare = host.replace(/^\[|\]$/g, '').toLowerCase();
+  if (bare === 'localhost' || bare === '::1' || bare === '::' || bare.startsWith('fe80:') || bare.startsWith('fc') || bare.startsWith('fd')) return true;
+  return LOCAL_V4.some(pattern => pattern.test(bare));
+}
+
+/**
+ * Resolve a CONNECT target against the run's admitted egress.
+ * @param {string|undefined} requestUrl the CONNECT request line target, "host:port"
+ * @param {{allowedDomains: string[], allowLocalBinding?: boolean}} policy
+ * @returns {{ok: true, host: string, port: number} | {ok: false, reason: string, host?: string, port?: number}}
+ */
+export function egressTarget(requestUrl, policy) {
+  if (typeof requestUrl !== 'string' || !requestUrl.includes(':')) return {ok: false, reason: 'egress_target_malformed'};
+  const separator = requestUrl.lastIndexOf(':');
+  const host = requestUrl.slice(0, separator);
+  const port = Number(requestUrl.slice(separator + 1));
+  if (!host || host.includes('/') || !Number.isSafeInteger(port)) return {ok: false, reason: 'egress_target_malformed'};
+  const bare = host.replace(/^\[|\]$/g, '');
+  if (!(policy.allowedDomains ?? []).some(entry => domainCovered(entry, bare))) return {ok: false, reason: 'egress_host_not_admitted', host: bare, port};
+  const local = isLocalAddress(host);
+  if (local && policy.allowLocalBinding !== true) return {ok: false, reason: 'egress_local_address_not_admitted', host: bare, port};
+  // A granted local service listens where it listens; a remote one is reached over the web.
+  if (!local && !WEB_PORTS.includes(port)) return {ok: false, reason: 'egress_port_not_admitted', host: bare, port};
+  if (local && (port < 1 || port > 65535)) return {ok: false, reason: 'egress_port_not_admitted', host: bare, port};
+  return {ok: true, host: bare, port};
+}
+
+/**
+ * Attach the CONNECT handler to a run-scoped HTTP server. With an empty admitted list this
+ * is exactly the previous behaviour: every CONNECT and every upgrade is refused.
+ * @param {import('node:http').Server} server
+ * @param {{allowedDomains: string[], allowLocalBinding?: boolean, observe: (event: Record<string, unknown>) => void}} policy
+ */
+export function attachEgress(server, policy) {
+  const observe = policy.observe ?? (() => {});
+  server.on('upgrade', (_req, socket) => socket.end('HTTP/1.1 403 Forbidden\r\n\r\n'));
+  server.on('connect', (req, socket, head) => {
+    const verdict = egressTarget(req.url, policy);
+    if (!verdict.ok) {
+      observe({kind: 'egress_request', host: verdict.host ?? null, port: verdict.port ?? null, allowed: false, reason: verdict.reason, bytes: 0});
+      socket.end('HTTP/1.1 403 Forbidden\r\n\r\n');
+      return;
+    }
+    let bytes = 0;
+    let settled = false;
+    const finish = (reason) => {
+      if (settled) return;
+      settled = true;
+      observe({kind: 'egress_request', host: verdict.host, port: verdict.port, allowed: true, ...(reason ? {reason} : {}), bytes});
+    };
+    const upstream = net.connect(verdict.port, verdict.host, () => {
+      // A public hostname that resolved onto a local address is refused after resolution,
+      // not before: the ceiling grants a name, never whatever that name points at today.
+      if (isLocalAddress(upstream.remoteAddress ?? '') && policy.allowLocalBinding !== true) {
+        upstream.destroy();
+        observe({kind: 'egress_request', host: verdict.host, port: verdict.port, allowed: false, reason: 'egress_resolved_local_address', bytes: 0});
+        socket.end('HTTP/1.1 403 Forbidden\r\n\r\n');
+        return;
+      }
+      socket.write('HTTP/1.1 200 Connection Established\r\n\r\n');
+      if (head && head.length) upstream.write(head);
+      socket.on('data', (chunk) => {bytes += chunk.length;});
+      upstream.on('data', (chunk) => {bytes += chunk.length;});
+      socket.pipe(upstream);
+      upstream.pipe(socket);
+    });
+    upstream.on('error', () => {
+      finish('egress_upstream_unreachable');
+      if (!socket.destroyed) socket.end('HTTP/1.1 502 Bad Gateway\r\n\r\n');
+    });
+    upstream.on('close', () => {finish(); socket.destroy();});
+    socket.on('error', () => {finish('egress_client_error'); upstream.destroy();});
+    socket.on('close', () => {finish(); upstream.destroy();});
+  });
+}
