+// A ticket that names what it needs cannot be satisfied by a run that did not have it.
+//
+// The defect this covers, observed 2026-09-11: a browser-QA assignment was delegated into a
+// capsule with no network and no read scope, every probe was refused by the boundary, the
+// run still ended `completed`, and the work was then done another way. Each test below is
+// one route by which that outcome must become a block that names the capsule field to fix.
+//
+// Unit evidence: injected run doubles and the real harness, schema parser and record store.
+// No model adapter is called.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {spawnSync} from 'node:child_process';
+import {realpathSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {createHash} from 'node:crypto';
+import {runTicketPlan, validateTicketPlan} from '../src/ticket-harness.js';
+import type {TicketPlan} from '../src/ticket-harness.js';
+import {createRunRecordStore} from '../src/run-record-store.js';
+
+const sha256 = (bytes: Buffer | string) => createHash('sha256').update(bytes).digest('hex');
+const RELEASE_DIGEST = 'a'.repeat(64);
+const EXPIRES = '2027-01-01T00:00:00Z';
+const HOST = 'www.rangerpainting.com';
+const TASK = 'Drive the site in a browser and report what the flow does.';
+const index = (root: string) => JSON.parse(readFileSync(join(root, 'var', 'tickets', 'qa-plan', 'index.json'), 'utf8'));
+
+interface Fixture {root: string; proj: string; ws: string; planPath: string; capsuleFile: string; taskFile: string}
+
+function fixture(requires: any, capsuleNetwork?: {allowedDomains: string[]; allowLocalBinding?: boolean}): Fixture {
+  const root = realpathSync(mkdtempSync(join(tmpdir(), 'ticket-gate-')));
+  const proj = join(root, 'proj');
+  const ws = join(root, 'checker');
+  mkdirSync(join(proj, 'tickets'), {recursive: true});
+  mkdirSync(join(root, 'var', 'runs'), {recursive: true});
+  mkdirSync(ws, {recursive: true});
+  writeFileSync(join(proj, 'SPEC.md'), 'QA the visualizer flow.');
+  const taskFile = join(proj, 'tickets', 'qa.task.md');
+  writeFileSync(taskFile, TASK + '\n');
+  const capsuleFile = join(proj, 'tickets', 'qa.capsule.json');
+  writeFileSync(capsuleFile, JSON.stringify({
+    version: capsuleNetwork ? 5 : 1, id: 'astra-visualizer-qa', releaseDigest: RELEASE_DIGEST,
+    workspaceRoot: proj, allowWrite: [proj], inputs: {[taskFile]: sha256(readFileSync(taskFile))},
+    requiredCharts: ['local-task'], ...(capsuleNetwork ? {skillPlan: [{chart: 'local-task', purpose: 'drive the flow'}]} : {}),
+    tools: ['Bash', 'Read', 'Write'], modelRoute: 'gpt-6-astra',
+    limits: {maxSeconds: 600, maxRequests: 10}, declaredOutputs: [join(proj, 'qa-report.md'), join(proj, 'report.json')],
+    expiresAt: EXPIRES, ...(capsuleNetwork ? {network: capsuleNetwork} : {}),
+  }, null, 2));
+  writeFileSync(join(ws, 'checker-capsule.json'), JSON.stringify({
+    version: 1, id: 'qa-checker', releaseDigest: RELEASE_DIGEST, workspaceRoot: ws, allowWrite: [ws],
+    requiredCharts: ['local-task'], modelRoute: 'command-local', limits: {maxSeconds: 120, maxRequests: 1},
+    declaredOutputs: [ws], expiresAt: EXPIRES,
+  }, null, 2));
+  const plan: TicketPlan = {
+    version: 1, id: 'qa-plan', goal: 'The visualizer flow is QA-ed in a browser.',
+    specRef: join(proj, 'SPEC.md'),
+    tickets: [{
+      id: 'qa', needs: [], result: 'qa-report.md describes the measured flow.',
+      workspace: proj, taskFile, capsuleFile, artifacts: [join(proj, 'qa-report.md'), join(proj, 'report.json')],
+      ...(requires ? {requires} : {}),
+      acceptance: {
+        functional: 'The report describes the flow.',
+        craft: 'Findings are located and concrete.',
+        checker: {workspace: ws, capsuleTemplate: join(ws, 'checker-capsule.json')},
+        checks: [{
+          id: 'report-shape',
+          command: ['/bin/sh', '-c', 'cp report.json evidence.json'],
+          copies: [{from: join(proj, 'report.json'), to: 'report.json'}],
+          evidence: 'evidence.json',
+        }],
+      },
+    } as any],
+  };
+  const planPath = join(root, 'plan.json');
+  writeFileSync(planPath, JSON.stringify(plan, null, 2));
+  return {root, proj, ws, planPath, capsuleFile, taskFile};
+}
+
+/** A worker double that "succeeds": it writes the declared artifact and completes. Its run
+ * record can carry boundary events, exactly as the native record does. */
+function worker(f: Fixture, {events = [] as any[], model = 'gpt-6-astra', evidence = '{"pass":true,"checks":1}'} = {}) {
+  const calls: any[] = [];
+  const run = async (opts: any) => {
+    calls.push(opts);
+    if (opts.adapter === 'command') {
+      const exec = spawnSync(opts.command[0], opts.command.slice(1), {cwd: opts.workspace, encoding: 'utf8'});
+      const store = createRunRecordStore(f.root, opts.runId);
+      const record = {id: store.id, status: exec.status === 0 ? 'completed' : 'blocked', startedAt: new Date().toISOString(),
+        releaseDigest: 'test', chartDigest: 'test', taskDigest: 'test', workspace: opts.workspace,
+        adapter: opts.adapter, modelRequests: 0, events: [], limits: [], exitCode: exec.status ?? 1};
+      store.save(record as any);
+      return record as any;
+    }
+    writeFileSync(join(f.proj, 'qa-report.md'), 'The flow was exercised.\n');
+    writeFileSync(join(f.proj, 'report.json'), evidence);
+    const store = createRunRecordStore(f.root, opts.runId);
+    const record = {id: store.id, status: 'completed', startedAt: new Date().toISOString(),
+      releaseDigest: 'test', chartDigest: 'test', taskDigest: 'test', workspace: opts.workspace,
+      adapter: opts.adapter, modelRequests: 1, events, limits: [], exitCode: 0, model};
+    store.save(record as any);
+    return record as any;
+  };
+  return {run, calls};
+}
+
+const workerCalls = (calls: any[]) => calls.filter(c => c.adapter !== 'command');
+
+test('a ticket whose capsule cannot reach what it requires never launches a worker', async (t) => {
+  const f = fixture({capsule: {network: [HOST]}});
+  t.after(() => rmSync(f.root, {recursive: true, force: true}));
+  const {run, calls} = worker(f);
+  const summary = await runTicketPlan(f.root, f.planPath, {run, checker: run});
+  const ticket = summary.tickets[0]!;
+  assert.equal(ticket.state, 'blocked');
+  assert.equal(ticket.classification, 'capsule_insufficient');
+  assert.match(ticket.reason!, new RegExp(HOST.replace(/\./g, '\\.')));
+  assert.match(ticket.reason!, /network/);
+  assert.equal(workerCalls(calls).length, 0, 'no model run may start against a capsule that cannot do the work');
+});
+
+test('the block clears only when the capsule changes, not when the task or the plan does', async (t) => {
+  const f = fixture({capsule: {network: [HOST]}});
+  t.after(() => rmSync(f.root, {recursive: true, force: true}));
+  const first = worker(f);
+  await runTicketPlan(f.root, f.planPath, {run: first.run, checker: first.run});
+
+  // Rewriting the assignment to describe a workaround changes nothing.
+  writeFileSync(f.taskFile, TASK + '\nIf the browser is unavailable, describe the flow from the source instead.\n');
+  const second = worker(f);
+  const retry = await runTicketPlan(f.root, f.planPath, {run: second.run, checker: second.run});
+  assert.equal(retry.tickets[0]!.state, 'blocked');
+  assert.equal(retry.tickets[0]!.classification, 'capsule_insufficient');
+  assert.equal(workerCalls(second.calls).length, 0);
+
+  // Granting the capsule what the ticket requires is the one thing that re-admits it.
+  const capsule = JSON.parse(readFileSync(f.capsuleFile, 'utf8'));
+  capsule.version = 5;
+  capsule.network = {allowedDomains: [HOST]};
+  capsule.skillPlan = [{chart: 'local-task', purpose: 'drive the flow'}];
+  capsule.inputs = {[f.taskFile]: sha256(readFileSync(f.taskFile))};
+  writeFileSync(f.capsuleFile, JSON.stringify(capsule, null, 2));
+  const third = worker(f);
+  const fixed = await runTicketPlan(f.root, f.planPath, {run: third.run, checker: third.run});
+  assert.equal(workerCalls(third.calls).length, 1, 'the corrected capsule launches the work');
+  assert.ok(['accepted', 'checking'].includes(fixed.tickets[0]!.state), fixed.tickets[0]!.state);
+});
+
+test('a completed run that was refused at the boundary is not an accepted run', async (t) => {
+  const f = fixture({capsule: {network: [HOST]}}, {allowedDomains: [HOST]});
+  t.after(() => rmSync(f.root, {recursive: true, force: true}));
+  const {run, calls} = worker(f, {events: [
+    {kind: 'egress_request', host: HOST, port: 443, allowed: false, reason: 'egress_host_not_admitted', bytes: 0},
+  ]});
+  const summary = await runTicketPlan(f.root, f.planPath, {run, checker: run});
+  assert.equal(workerCalls(calls).length, 1, 'the run was allowed to start: its capsule declared the host');
+  assert.equal(summary.tickets[0]!.state, 'blocked');
+  assert.equal(summary.tickets[0]!.classification, 'capsule_insufficient');
+  assert.match(summary.tickets[0]!.reason!, /egress_host_not_admitted/);
+});
+
+test('artifacts produced by another route do not satisfy a ticket that names its route', async (t) => {
+  const f = fixture({route: 'gpt-6-astra'});
+  t.after(() => rmSync(f.root, {recursive: true, force: true}));
+  const {run} = worker(f, {model: 'claude-opus-5'});
+  const summary = await runTicketPlan(f.root, f.planPath, {run, checker: run});
+  assert.equal(summary.tickets[0]!.state, 'blocked');
+  assert.equal(summary.tickets[0]!.classification, 'capsule_insufficient');
+  assert.match(summary.tickets[0]!.reason!, /claude-opus-5/);
+  assert.match(summary.tickets[0]!.reason!, /gpt-6-astra/);
+});
+
+test('evidence without the receipt the ticket requires is a missing capability, not a pass', async (t) => {
+  const f = fixture({receipts: ['screenshots', 'urls']});
+  t.after(() => rmSync(f.root, {recursive: true, force: true}));
+  const {run} = worker(f, {evidence: '{"pass":true,"checks":1}'});
+  const summary = await runTicketPlan(f.root, f.planPath, {run, checker: run});
+  assert.equal(summary.tickets[0]!.state, 'blocked');
